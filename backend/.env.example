# ==========================================================================
# Backend environment - copy to `.env` and fill in your values.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# Empty / unset values fall back to the code defaults, so you only need to
# set what you actually use.
# ==========================================================================

# ── Core ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gate_mock_test
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ==========================================================================
# LLM PROVIDER
# --------------------------------------------------------------------------
# Pick ONE provider, then give it a key + model. You almost never need to
# edit code - the provider system is data-driven.
#
# Two ways to configure any provider:
#
#   A) Per-provider vars:  <PROVIDER>_API_KEY / <PROVIDER>_MODEL / <PROVIDER>_BASE_URL
#   B) Generic fallback:   LLM_API_KEY / LLM_MODEL / LLM_BASE_URL  (works for ANY provider)
#
# Per-provider vars win over the generic ones. Resolution precedence:
#   base_url : <PROVIDER>_BASE_URL > LLM_BASE_URL > built-in default > SDK default
#   api_key  : <PROVIDER>_API_KEY  > LLM_API_KEY  > placeholder (keyless local)
#   model    : <PROVIDER>_MODEL     > LLM_MODEL     > built-in default
#
# Built-in presets (default base URLs already known - no URL needed):
#   openai, anthropic, nebius, deepseek, openrouter, groq, together, xai,
#   mistral, moonshot, kimi, ollama, lmstudio
# Universal escape hatch for anything else: openai_compatible (+ a base URL).
# ==========================================================================

LLM_PROVIDER=nebius

# ── Examples (uncomment ONE block) ─────────────────────────────────────────

# Nebius (default, OpenAI-compatible) ........................................
NEBIUS_API_KEY=
NEBIUS_MODEL=deepseek-ai/DeepSeek-V3.2
# NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/   # optional - has a default

# OpenAI ....................................................................
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                                    # optional OpenAI-compatible gateway

# Anthropic .................................................................
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek ..................................................................
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# Moonshot / Kimi ...........................................................
# LLM_PROVIDER=kimi
# KIMI_API_KEY=sk-...
# KIMI_MODEL=kimi-k2-0711-preview
# KIMI_BASE_URL=https://api.moonshot.cn/v1            # optional (China region)

# OpenRouter ................................................................
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-chat

# Groq ......................................................................
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (no key needed) ..............................................
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434/v1           # optional - has a default

# Any other OpenAI-compatible endpoint (vLLM, LM Studio, a relay, ...) .......
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-endpoint/v1               # REQUIRED for this mode
# LLM_API_KEY=your-token                              # optional for local servers
# LLM_MODEL=your-model-id

# ── LLM tuning (sensible defaults; override only if needed) ────────────────
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0.7
LLM_TEMPERATURE_VERIFY=0.1
LLM_BATCH_SIZE=5
LLM_MAX_CONCURRENCY=2
LLM_RETRIES=2
LLM_TIMEOUT_SECONDS=120

# ── PDF / LaTeX ────────────────────────────────────────────────────────────
LATEX_BUILD_URL=https://latex.ytotech.com/builds/sync
LATEX_COMPILER=xelatex

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
